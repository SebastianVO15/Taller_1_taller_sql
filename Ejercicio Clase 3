-- Ejercicio 1
CREATE TABLE lector (
  id int,
  nombre varchar(20) not null,
  apellido varchar(20) not null,
  correo varchar(40) not null,
  fecha_afiliacion date not null,

  primary key (id)
);

CREATE TABLE libro (
  id int,
  titulo varchar(40) not null,
  autor varchar(40) not null,
  anio int not null,
  precio_reposicion int not null,

  primary key (id)
); 

